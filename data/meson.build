# Data files for Phi PDF Viewer

# Desktop file
install_data(
  'arpa.sp1rit.phi.viewer.desktop',
  install_dir: get_option('datadir') / 'applications'
)

# Appstream metainfo
install_data(
  'arpa.sp1rit.phi.viewer.metainfo.xml',
  install_dir: get_option('datadir') / 'metainfo'
)

# Icons
install_data(
  'icons/hicolor/scalable/apps/arpa.sp1rit.phi.viewer.svg',
  install_dir: get_option('datadir') / 'icons/hicolor/scalable/apps'
)

install_data(
  'icons/hicolor/256x256/apps/arpa.sp1rit.phi.viewer.png',
  install_dir: get_option('datadir') / 'icons/hicolor/256x256/apps'
)
