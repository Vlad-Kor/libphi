[Desktop Entry]
Name=Phi Document Viewer
Comment=View PDFs and edit Markdown notes
GenericName=Document Viewer
Exec=pdfv %U
Icon=ai.korsakov.Phi
Terminal=false
Type=Application
Categories=Office;Viewer;GTK;
MimeType=application/pdf;text/markdown;text/x-markdown;
Keywords=PDF;Markdown;document;viewer;editor;
StartupNotify=true
StartupWMClass=ai.korsakov.Phi
